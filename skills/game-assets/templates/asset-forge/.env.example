# Roblox Open Cloud (only needed for target "roblox"). Copy to .env, never commit .env.
# API key: Creator Hub > Open Cloud > API Keys, permissions asset:read + asset:write, restricted to your IP.
ROBLOX_API_KEY=
# Numeric user ID (or group ID when ROBLOX_CREATOR_TYPE=Group)
ROBLOX_CREATOR_ID=
# User | Group
ROBLOX_CREATOR_TYPE=User
